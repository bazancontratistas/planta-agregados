rules_version = '2';

// Reglas de seguridad de la app Control Planta Agregados.
// Copia de referencia. Antes de publicarlas en Firebase, pon en correosDuenos()
// los correos de Google de los dueños, en minúsculas. No subas a GitHub los correos reales.

service cloud.firestore {
  match /databases/{database}/documents {

    function correosDuenos() { return ['TU_CORREO@gmail.com']; }

    // Trabajadores sin correo: entran con usuario y contraseña. Por dentro su cuenta es
    // usuario@planta-agregados.firebaseapp.com (una dirección que no recibe correos).
    function interno()      { return request.auth != null
                                && request.auth.token.firebase.sign_in_provider == 'password'
                                && request.auth.token.email.lower().matches('^[a-z0-9._-]+@planta-agregados[.]firebaseapp[.]com$'); }

    function logueado()     { return request.auth != null && (request.auth.token.email_verified == true || interno()); }
    function correo()       { return request.auth.token.email.lower(); }
    function esDueno()      { return logueado() && !interno() && correo() in correosDuenos(); }
    function registrado()   { return logueado() && exists(/databases/$(database)/documents/usuarios/$(correo())); }
    function rol()          { return get(/databases/$(database)/documents/usuarios/$(correo())).data.rol; }
    function esAdmin()      { return esDueno() || (registrado() && rol() == 'admin'); }
    function puedeEscribir(){ return esAdmin() || (registrado() && rol() == 'editor'); }
    function puedeLeer()    { return esAdmin() || (registrado() && rol() in ['editor', 'lector']); }

    // Quién puede entrar y con qué permiso: solo administradores lo cambian.
    // Cada trabajador solo puede marcar que ya cambió su contraseña.
    match /usuarios/{email} {
      allow read: if puedeLeer() || (logueado() && email == correo());
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (registrado() && email == correo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['debeCambiar', 'claveCambiadaEn'])
        && request.resource.data.debeCambiar == false);
    }

    // Usuario -> cuenta interna. Se consulta en la pantalla de inicio, antes de entrar.
    match /alias/{u} {
      allow get: if true;
      allow list, write: if esAdmin();
    }

    // Precios y datos de la empresa: solo administradores.
    match /productos/{id} { allow read: if puedeLeer(); allow write: if esAdmin(); }
    match /config/{id}    { allow read: if puedeLeer(); allow write: if esAdmin(); }

    // Numeración de tickets.
    match /contadores/{id} { allow read: if puedeLeer(); allow write: if puedeEscribir(); }

    // Clientes: registran y editan; solo administradores borran.
    match /clientes/{id} {
      allow read: if puedeLeer();
      allow create, update: if puedeEscribir();
      allow delete: if esAdmin();
    }

    // Sencillo, conteo y cierre de cada día.
    match /dias/{id} { allow read: if puedeLeer(); allow write: if puedeEscribir(); }

    // Tickets y gastos. Un ticket no se borra (se anula) y su número no se cambia.
    match /m/{mes}/mov/{id} {
      allow read: if puedeLeer();
      allow create: if puedeEscribir();
      allow update: if puedeEscribir()
        && request.resource.data.get('ticketN', null) == resource.data.get('ticketN', null)
        && request.resource.data.get('ticket', '') == resource.data.get('ticket', '');
      allow delete: if esAdmin() || (puedeEscribir() && !('ticketN' in resource.data));
    }

    // Registro diario de volquetes.
    match /m/{mes}/volquetes/{id} { allow read: if puedeLeer(); allow write: if puedeEscribir(); }

    // Diésel: saldo de tanques, lista de equipos y movimientos.
    match /tanques/{id} { allow read: if puedeLeer(); allow write: if puedeEscribir(); }
    match /equipos/{id} {
      allow read: if puedeLeer();
      allow create, update: if puedeEscribir();
      allow delete: if esAdmin();
    }
    match /m/{mes}/diesel/{id} { allow read: if puedeLeer(); allow write: if puedeEscribir(); }

    // Facturas con sus guías. No se borran: se anulan.
    match /facturas/{id} {
      allow read: if puedeLeer();
      allow create, update: if puedeEscribir();
      allow delete: if esAdmin();
    }
  }
}
